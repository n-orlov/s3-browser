{
  "name": "s3-browser",
  "version": "0.18.9",
  "description": "Lightweight desktop S3 file browser",
  "main": "dist/main/index.js",
  "author": "Nikolai Orlov",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint . --max-warnings 0",
    "crap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crap/crap.ts",
    "ratchet:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ratchet/ratchet.ts",
    "mutation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mutation/mutation.ts",
    "badges": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/badges/render.ts",
    "badges:readme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/badges/readme.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --spec-version 1.6 --output-file sbom/sbom.cdx.json",
    "test:e2e": "npm run build && xvfb-run --auto-servernum --server-args=\"-screen 0 1280x960x24\" playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:docker": "./scripts/e2e-docker.sh",
    "package": "npm run build && npx electron-builder --linux",
    "package:win": "npm run build && npx electron-builder --win",
    "package:win:docker": "./scripts/build-windows.sh",
    "package:mac": "npm run build && npx electron-builder --mac",
    "package:mac:unsigned": "npm run build && npx electron-builder --mac -c.mac.identity=null",
    "package:mac:script": "./scripts/build-macos.sh",
    "package:all": "npm run build && npx electron-builder --win --mac --linux",
    "package:all:docker": "./scripts/build-all.sh"
  },
  "build": {
    "appId": "org.github.n-orlov.s3-browser",
    "productName": "S3 Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!**/__tests__/**",
      "!**/*.test.*",
      "!**/e2e/**",
      "!**/coverage/**",
      "!**/*.map",
      "!**/.env*",
      "!**/*.pem",
      "!**/*.key",
      "!**/credentials",
      "!**/.npmrc"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "S3 Browser - Drag to Applications, then run: xattr -cr /Applications/S3\\ Browser.app",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/credential-providers": "^3.1149.0",
    "@monaco-editor/react": "^4.7.0",
    "hyparquet": "^1.31.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@smithy/util-stream": "^4.8.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "allure-playwright": "^3.13.0",
    "allure-vitest": "^3.13.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "concurrently": "^10.0.6",
    "electron": "^40.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  }
}
