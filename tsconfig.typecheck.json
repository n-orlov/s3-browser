{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*", "e2e/**/*", "playwright.config.ts", "vitest.config.ts", "vite.config.ts", "scripts/**/*.ts"]
}
